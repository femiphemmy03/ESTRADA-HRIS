// ESTRADA HRIS — Prisma schema
// Single source of truth: every module below references Employee.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================================
// ENUMS
// ==========================================================

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  HR_MANAGER
  PAYROLL_OFFICER
  TEAM_LEAD
  EMPLOYEE
}

enum EmploymentStatus {
  ONBOARDING
  ACTIVE
  ON_LEAVE
  SUSPENDED
  EXITING
  EXITED
}

enum OnboardingStatus {
  INVITED
  ACCOUNT_CREATED
  DOCS_ACKNOWLEDGED
  BIODATA_COMPLETE
  DOCS_UPLOADED
  SUBMITTED
  APPROVED
}

enum DocumentOwner {
  COMPANY
  EMPLOYEE
}

enum DocumentAckStatus {
  NOT_REQUIRED
  PENDING
  ACKNOWLEDGED
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_DEPARTURE
  HALF_DAY
  ABSENT
  WEEKEND
  PUBLIC_HOLIDAY
  ON_LEAVE
  MISSING_CHECKOUT
  OVERTIME
}

enum SiteApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveRequestStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollRunStatus {
  DRAFT
  REVIEW
  PENDING_HR_MANAGER
  PENDING_SUPER_ADMIN
  APPROVED
  PAID
  REJECTED
}

enum PaymentApproval {
  PENDING
  APPROVED
}

enum PaymentStatus {
  NOT_PAID
  PROCESSING
  SUCCESS
  FAILED
}

enum WalletKind {
  PERSONAL
  CLIENT
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum WalletTxnType {
  FUNDING
  SALARY_CREDIT
  DISBURSEMENT
  WITHDRAWAL
  ADJUSTMENT
}

enum WalletTxnDirection {
  CREDIT
  DEBIT
}

enum WalletTxnStatus {
  PENDING
  SUCCESS
  FAILED
  REJECTED
}

enum ExitStatus {
  INITIATED
  CLEARANCE_IN_PROGRESS
  INTERVIEW_DONE
  FINAL_SETTLEMENT
  ARCHIVED
}

// ==========================================================
// USERS / AUTH
// ==========================================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  role          Role     @default(EMPLOYEE)
  isActive      Boolean  @default(true)
  mustSetPassword Boolean @default(true)
  invitationToken String? @unique
  invitationExpiresAt DateTime?
  passwordResetToken String? @unique
  passwordResetExpiresAt DateTime?
  refreshTokenVersion Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee?
  activityLogs  ActivityLog[] @relation("ActorLogs")

  clientAssignments ClientAssignment[]
  wallet            Wallet?
  notifications     Notification[]
}

// ==========================================================
// EMPLOYEE MANAGEMENT (the master record)
// ==========================================================

model Employee {
  id               String            @id @default(uuid())
  employeeCode     String            @unique // e.g. EST-2026-0001
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id])

  firstName        String
  lastName         String
  middleName       String?
  phone            String?
  gender           String?
  dateOfBirth      DateTime?
  passportPhotoUrl String?

  departmentId     String?
  department       Department?       @relation(fields: [departmentId], references: [id])
  positionId       String?
  position         Position?         @relation(fields: [positionId], references: [id])
  clientId         String?
  client           Client?           @relation(fields: [clientId], references: [id])
  siteId           String?
  site              Site?            @relation(fields: [siteId], references: [id])
  teamLeadId       String?
  teamLead         Employee?         @relation("TeamLeadReports", fields: [teamLeadId], references: [id])
  reports          Employee[]        @relation("TeamLeadReports")

  employmentStatus EmploymentStatus  @default(ONBOARDING)
  onboardingStatus OnboardingStatus  @default(INVITED)
  dateHired        DateTime?
  archived         Boolean           @default(false)

  address          String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRelationship String?
  nextOfKinName    String?
  nextOfKinPhone   String?
  nextOfKinRelationship String?

  bankName         String?
  bankAccountNumber String?
  bankAccountName  String?
  pensionRSA       String?
  pensionAdmin     String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  educationHistory   EducationHistory[]
  employmentHistory  EmploymentHistoryEntry[]
  documents          Document[]
  activityLogs       ActivityLog[]      @relation("SubjectLogs")
  onboardingTasks     OnboardingTask[]
  attendances        Attendance[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]     @relation("LeaveRequester")
  salaryStructure    SalaryStructure?
  payslips           Payslip[]
  loans              Loan[]
  salaryAdvances     SalaryAdvance[]
  exitProcess        ExitProcess?
  siteApprovalsMade  Site[]             @relation("SiteApprovedBy")
  wallet             Wallet?
}

model EducationHistory {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  institution String
  qualification String
  fieldOfStudy String?
  startYear   Int?
  endYear     Int?
}

model EmploymentHistoryEntry {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  company     String
  role        String
  startDate   DateTime?
  endDate     DateTime?
  description String?
}

model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  employees Employee[]
  positions Position[]
  documents Document[]
  createdAt DateTime   @default(now())
}

model Position {
  id           String     @id @default(uuid())
  title        String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  employees    Employee[]
}

// ==========================================================
// CLIENT & SITE MANAGEMENT
// ==========================================================

model Client {
  id        String   @id @default(uuid())
  name      String   @unique
  contactName String?
  contactEmail String?
  contactPhone String?
  isActive  Boolean  @default(true)
  sites     Site[]
  employees Employee[]
  payrollSettings PayrollSettings[]
  assignments     ClientAssignment[]
  wallet          Wallet?
  attendanceRule  AttendanceRule?
  payrollRuns     PayrollRun[]
  createdAt DateTime @default(now())
}

model Site {
  id              String   @id @default(uuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  name            String
  address         String?
  latitude        Float
  longitude       Float
  radiusMeters    Int      @default(150)
  teamLeadId      String?
  shift           String?
  approvalStatus  SiteApprovalStatus @default(PENDING)
  proposedById    String?
  approvedById    String?
  approvedBy      Employee? @relation("SiteApprovedBy", fields: [approvedById], references: [id])
  isActive        Boolean  @default(true)
  employees       Employee[]
  attendanceRule  AttendanceRule?
  attendances     Attendance[]
  createdAt       DateTime @default(now())
}

// ==========================================================
// ATTENDANCE RULE ENGINE
// ==========================================================

model AttendanceRule {
  id                 String   @id @default(uuid())
  siteId             String?  @unique
  site               Site?    @relation(fields: [siteId], references: [id])
  // A rule can belong to a whole client (applies to every site of that client that has no rule of its own).
  // Lookup order for an employee: their site's rule -> their client's rule -> the company default.
  clientId           String?  @unique
  client             Client?  @relation(fields: [clientId], references: [id])
  isDefault          Boolean  @default(false)
  name               String
  workingDays        String   // csv e.g. "MON,TUE,WED,THU,FRI" — all days attendance is expected (onsite + remote)
  remoteDays         String   @default("") // csv subset of workingDays that are WFH/remote — GPS check is skipped on these
  shiftStart         String   // "08:00"
  shiftEnd           String   // "17:00"
  gracePeriodMinutes Int      @default(15)
  minimumHours       Float    @default(8)
  halfDayHours       Float    @default(4)
  overtimeThresholdHours Float @default(9)
  gpsRadiusMeters    Int      @default(150)
  latePolicy         String?
  earlyCheckoutPolicy String?
  weekendPolicy      String?
  holidayPolicy      String?
  requiresApproval   Boolean  @default(false)
  // Fixed attendance expectation for payroll, e.g. 20 days a month. When prorateSalary is on,
  // anyone with fewer present days is paid days present / required days of their monthly pay.
  requiredDaysPerMonth Int?
  prorateSalary      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PublicHoliday {
  id      String   @id @default(uuid())
  name    String
  date    DateTime
  siteId  String?
}

// ==========================================================
// ATTENDANCE
// ==========================================================

model Attendance {
  id            String            @id @default(uuid())
  employeeId    String
  employee      Employee          @relation(fields: [employeeId], references: [id])
  siteId        String?
  site          Site?             @relation(fields: [siteId], references: [id])
  date          DateTime
  checkInAt     DateTime?
  checkInLat    Float?
  checkInLng    Float?
  checkOutAt    DateTime?
  checkOutLat   Float?
  checkOutLng   Float?
  hoursWorked   Float?
  status        AttendanceStatus  @default(ABSENT)
  workMode      String            @default("ONSITE") // "ONSITE" | "REMOTE"
  notes         String?
  createdAt     DateTime          @default(now())

  @@unique([employeeId, date])
}

// ==========================================================
// LEAVE MANAGEMENT
// ==========================================================

model LeaveType {
  id             String   @id @default(uuid())
  name           String   @unique
  defaultDaysPerYear Int  @default(0)
  isPaid         Boolean  @default(true)
  leaveRequests  LeaveRequest[]
  leaveBalances  LeaveBalance[]
}

model LeaveBalance {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  entitledDays Float
  usedDays    Float    @default(0)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation("LeaveRequester", fields: [employeeId], references: [id])
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate     DateTime
  endDate       DateTime
  daysRequested Float
  reason        String?
  status        LeaveRequestStatus @default(PENDING_MANAGER)
  managerApprovedById String?
  managerApprovedAt   DateTime?
  hrApprovedById      String?
  hrApprovedAt        DateTime?
  rejectionReason     String?
  createdAt     DateTime @default(now())
}

// ==========================================================
// PAYROLL
// ==========================================================

model SalaryStructure {
  id           String   @id @default(uuid())
  employeeId   String   @unique
  employee     Employee @relation(fields: [employeeId], references: [id])
  basicSalary  Float
  allowances   Json     @default("[]") // [{ name, amount }] — Housing/Transport included by default (BHT)
  deductions   Json     @default("[]") // [{ name, amount }]
  // Statutory deductions are OFF by default per employee — must be explicitly enabled.
  // Previously PAYE/Pension/NHF applied to every employee uniformly with no way to exclude
  // anyone (contractors, exempt staff, different arrangements), which threw off net pay.
  payeEnabled     Boolean @default(false)
  pensionEnabled  Boolean @default(false)
  nhfEnabled      Boolean @default(false)
  effectiveFrom DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PayrollSettings {
  id              String   @id @default(uuid())
  name            String
  type            String   // PAYE | PENSION_EMPLOYEE | PENSION_EMPLOYER | NHF | CUSTOM
  config          Json
  clientId        String?  // null = company-wide fallback; set = overrides for that specific client
  client          Client?  @relation(fields: [clientId], references: [id])
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model PayrollRun {
  id          String   @id @default(uuid())
  month       Int
  year        Int
  // One run per client per month. Runs created before client-wise payroll have clientId = null (legacy, company-wide).
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  status      PayrollRunStatus @default(DRAFT)

  // Two-tier approval trail: submitted (by Payroll Officer/HR Admin/Super Admin) ->
  // HR Manager approves -> Super Admin gives final approval, at which point payslip
  // PDFs are generated automatically and become visible on each employee's payroll tab.
  submittedById         String?
  submittedAt           DateTime?
  hrManagerApprovedById String?
  hrManagerApprovedAt   DateTime?
  approvedById          String? // Super Admin final approval
  approvedAt            DateTime?
  rejectionReason       String?

  createdAt   DateTime @default(now())
  payslips    Payslip[]

  @@unique([month, year, clientId])
  @@index([clientId])
}

model Payslip {
  id            String   @id @default(uuid())
  payrollRunId  String
  payrollRun    PayrollRun @relation(fields: [payrollRunId], references: [id])
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  basicSalary   Float
  grossAllowances Float
  totalDeductions Float
  overtimePay   Float    @default(0)
  paye          Float    @default(0)
  pensionEmployee Float  @default(0)
  nhf           Float    @default(0)
  netPay        Float
  breakdown     Json
  pdfUrl        String?
  createdAt     DateTime @default(now())

  // Attendance-based proration (null when the client has no fixed-days rule)
  daysPresent     Float?
  requiredDays    Int?
  prorationFactor Float?

  // What the employee actually receives, and the payment trail
  totalPayable      Float          @default(0)
  paymentApproval   PaymentApproval @default(PENDING)
  paymentApprovedById String?
  paymentApprovedAt DateTime?
  paymentStatus     PaymentStatus  @default(NOT_PAID)
  paymentReference  String?
  paymentMessage    String?
  paidAt            DateTime?

  @@unique([payrollRunId, employeeId])
  @@index([paymentStatus])
}

model Loan {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  principal    Float
  monthlyDeduction Float
  balanceRemaining Float
  reason       String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
}

model SalaryAdvance {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  amount       Float
  reason       String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
}

// ==========================================================
// DOCUMENT MANAGEMENT
// ==========================================================

model DocumentType {
  id           String   @id @default(uuid())
  name         String   @unique
  owner        DocumentOwner
  requiresAck  Boolean  @default(false)
  expiryTrackingEnabled Boolean @default(false)
  documents    Document[]
}

model Document {
  id             String   @id @default(uuid())
  documentTypeId String?
  documentType   DocumentType? @relation(fields: [documentTypeId], references: [id])
  title          String?
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  employeeId     String?
  employee       Employee? @relation(fields: [employeeId], references: [id])
  fileUrl        String
  fileName       String
  storagePath    String
  ackStatus      DocumentAckStatus @default(NOT_REQUIRED)
  acknowledgedAt DateTime?
  expiryDate     DateTime?
  uploadedAt     DateTime @default(now())
}

// ==========================================================
// ONBOARDING
// ==========================================================

model OnboardingTask {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  label       String
  isComplete  Boolean  @default(false)
  completedAt DateTime?
  order       Int      @default(0)
}

// ==========================================================
// EXIT MANAGEMENT
// ==========================================================

model ExitProcess {
  id              String   @id @default(uuid())
  employeeId      String   @unique
  employee        Employee @relation(fields: [employeeId], references: [id])
  status          ExitStatus @default(INITIATED)
  reason          String?
  lastWorkingDay  DateTime?
  clearanceTasks  ExitClearanceTask[]
  exitInterviewNotes String?
  finalSettlementAmount Float?
  createdAt       DateTime @default(now())
  archivedAt      DateTime?
}

model ExitClearanceTask {
  id            String   @id @default(uuid())
  exitProcessId String
  exitProcess   ExitProcess @relation(fields: [exitProcessId], references: [id])
  label         String
  isComplete    Boolean  @default(false)
  completedAt   DateTime?
}

// ==========================================================
// ACTIVITY LOG / AUDIT
// ==========================================================

model ActivityLog {
  id          String   @id @default(uuid())
  employeeId  String?
  employee    Employee? @relation("SubjectLogs", fields: [employeeId], references: [id])
  actorUserId String?
  actor       User?    @relation("ActorLogs", fields: [actorUserId], references: [id])
  action      String
  description String
  metadata    Json?
  // module + clientId let the Super Admin filter the audit trail (e.g. everything PAYROLL for one client).
  module      String?
  clientId    String?
  createdAt   DateTime @default(now())

  @@index([module, createdAt])
  @@index([clientId])
}

// ==========================================================
// CLIENT SCOPING (which admin looks after which client)
// ==========================================================

model ClientAssignment {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Whether this admin may submit funding for this client's wallet.
  canFund      Boolean  @default(true)
  assignedById String?
  createdAt    DateTime @default(now())

  @@unique([userId, clientId])
  @@index([clientId])
}

// ==========================================================
// WALLETS
// ==========================================================
// PERSONAL wallets belong to a person (every User has at most one; linked to their Employee
// record when they have one). CLIENT wallets hold the money an Estrada client has funded for
// salary disbursement. walletCode is its own identifier — it is NEVER derived from employeeCode,
// so employee IDs can be retired/recycled by HR without ever touching money records.

model Wallet {
  id         String       @id @default(uuid())
  walletCode String       @unique
  kind       WalletKind
  status     WalletStatus @default(ACTIVE)

  userId     String?      @unique
  user       User?        @relation(fields: [userId], references: [id])
  employeeId String?      @unique
  employee   Employee?    @relation(fields: [employeeId], references: [id])
  clientId   String?      @unique
  client     Client?      @relation(fields: [clientId], references: [id])

  balance    Decimal      @default(0) @db.Decimal(18, 2)
  currency   String       @default("NGN")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id            String             @id @default(uuid())
  walletId      String
  wallet        Wallet             @relation(fields: [walletId], references: [id])
  type          WalletTxnType
  direction     WalletTxnDirection
  amount        Decimal            @db.Decimal(18, 2)
  balanceAfter  Decimal?           @db.Decimal(18, 2)
  status        WalletTxnStatus    @default(PENDING)
  reference     String             @unique
  description   String?
  clientId      String?
  initiatedById String?
  confirmedById String?
  confirmedAt   DateTime?
  provider      String             @default("MANUAL") // MANUAL | FLUTTERWAVE
  providerRef   String?
  metadata      Json?
  createdAt     DateTime           @default(now())

  @@index([walletId, createdAt])
  @@index([clientId])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}
